  "base_url": "https://bridge.bifrostcrypto.com",
  "max_retries": 2,
  "default_retry_delay_ms": 1000,
  "max_payouts": 50,
  "paths": {
    "payout": "/v1/payout",
    "list_payout": "/v1/list-payout",
    "check_payout": "/v1/check-payout",
    "payin": "/v1/payin",
