  "rate_limit": {
    "status": 429,
    "body": {
      "error": "rate_limit_exceeded",
      "message": "Request limit exceeded",
      "details": {
        "limit": 100,
        "window_seconds": 60,
        "retry_after_seconds": 24,
        "retry_after_formatted": "24 seconds"
      }
    }
  },
